# RabbitMQ Configuration (CRITICAL)
# RABBITMQ_URL=amqp://localhost:5672  # Optional: Full connection URL (overrides individual settings)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# External Services (from other teams)
USER_SERVICE_URL=http://localhost:3001
TEMPLATE_SERVICE_URL=http://localhost:3002
API_GATEWAY_URL=http://localhost:3000

# SMTP Email Provider
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@example.com

# Optional: Alternative Email Providers
# SENDGRID_API_KEY=your-sendgrid-key
# MAILGUN_API_KEY=your-mailgun-key
# MAILGUN_DOMAIN=your-domain.com

# Application
PORT=3003
NODE_ENV=development
